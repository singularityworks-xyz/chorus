{
  "compilerOptions": {
    "target": "ES2021",
    // Bun supports these APIs while Serve targets ES2021.
    "lib": ["ES2022"],
    "ignoreDeprecations": "6.0",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@chorus/contracts": ["../../packages/contracts/src"],
      "@chorus/voice": ["../../packages/voice/src"]
    },
    "types": ["bun-types"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true
  }
}
