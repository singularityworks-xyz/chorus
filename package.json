{
  "name": "chorus",
  "version": "0.1.67",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "bun test",
    "changeset": "changeset",
    "prepare": "lefthook install",
    "version:autobump": "bun scripts/version/autobump.ts",
    "check-types": "tsc --noEmit -p tsconfig.json && turbo run check-types",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "check": "ultracite fix && bun run check:log",
    "check:log": "bun scripts/check-log-gate.ts",
    "e2e": "bun scripts/run-e2e.ts",
    "e2e:install": "playwright install chromium"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@changesets/cli": "^2.30.0",
    "@playwright/test": "^1.63.0",
    "@types/bun": "^1.3.11",
    "@types/node": "^25.5.2",
    "bun-types": "1.3.11",
    "lefthook": "^2.1.4",
    "monaco-editor": "npm:@codingame/monaco-vscode-editor-api",
    "turbo": "^2.9.3",
    "typescript": "^6.0.2",
    "ultracite": "^7.4.3",
    "vite": "^8.0.3",
    "vscode": "npm:@codingame/monaco-vscode-extension-api",
    "zod": "^4.3.6"
  },
  "packageManager": "bun@1.4.0",
  "trustedDependencies": [
    "opencode-ai"
  ],
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
