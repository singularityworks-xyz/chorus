# Chorus environment
#
# Values are the Phase 0 skeleton. Phase 8 completes annotations with the
# consequence of omitting each variable. Do not commit real secrets.

# ── Server ────────────────────────────────────────────────────────────────
PORT=2000                        # optional, default 2000 — listen port
NODE_ENV=production              # production enables Secure cookies + strict CORS
DATA_DIR=/data                   # optional, default /data — chorus.db, snapshots, chorus.token
CHORUS_TOKEN=                    # REQUIRED in production (hard boot failure if unset);
                                 # laptop/dev auto-generates into <DATA_DIR>/chorus.token (0600)
                                 # generate with: openssl rand -hex 32
CHORUS_REPOSITORY_ROOTS=[]       # optional JSON array of operator-approved absolute Git checkout roots;
                                 # laptop folder-picker registrations are stored in chorus.db

# ── OpenCode engine ───────────────────────────────────────────────────────
OPENCODE_DIRECTORY=/workspaces   # optional — default working directory for the engine
OPENCODE_AUTO_START=              # optional — defaults true for local URL, false for remote URL;
                                 # remote URLs cannot spawn a local child
OPENCODE_PORT=4096               # optional, default 4096 — port serve spawns `opencode serve` on.
                                 # Also the default for OPENCODE_BASE_URL below, so the two
                                 # cannot drift apart. Set OPENCODE_BASE_URL instead to point
                                 # at an engine running somewhere else.
OPENCODE_BASE_URL=http://127.0.0.1:4096
                                 # optional — where clients send engine requests. Defaults to
                                 # http://127.0.0.1:$OPENCODE_PORT. Set it to use an external
                                 # engine; serve never spawns a local child for a remote URL.
OPENCODE_USERNAME=               # optional — configure together with OPENCODE_PASSWORD
OPENCODE_PASSWORD=               # optional — sent only to the configured OpenCode origin
OPENCODE_PER_WORKTREE=false      # optional, default false — start one managed engine per
                                 # canonical board checkout; requires a local auto-start URL

# ── Storage (Phase 2 — live) ─────────────────────────────────────────────
RETENTION_DAYS=30                # optional, default 30 — terminal-run detail retention.
                                 # must be positive; compacts step transcripts older than this
DB_SIZE_CAP_MB=512               # optional, default 512 — hard event-log size cap
SNAPSHOT_INTERVAL=1000           # optional, default 1000 — events between full-state snapshots
CHORUS_ENABLE_LEGACY_WORKSPACE_IMPORT=false
                                 # optional, default false — one-shot import of the
                                 # pre-Phase-2 workspace.json into SQLite. A corrupt legacy
                                 # file aborts boot rather than starting empty.

# ── Web Push approvals ────────────────────────────────────────────────────
PUSH_ENABLED=                    # optional — true generates/reuses persisted VAPID keys;
                                 # false disables push; a complete key pair enables by default
VAPID_PUBLIC_KEY=                # optional P-256 public key; configure together with private
VAPID_PRIVATE_KEY=               # optional P-256 private key; never logged or returned to browsers
VAPID_SUBJECT=                   # required when enabled, e.g. mailto:admin@example.com or HTTPS contact
PUSH_ALLOWED_HOSTS=              # optional comma-separated additional provider hostnames; built-in providers are allowed

# ── Web app → serve wiring ─────────────────────────────────────────────────
CHORUS_SERVE_URL=http://localhost:2000
                                 # server-side only — where the Next app proxies API calls.
                                 # optional, default http://localhost:2000
NEXT_PUBLIC_CHORUS_WS_URL=http://localhost:2000
                                 # browser-visible WebSocket address (the /ws path is appended).
                                 # REQUIRED when Next is served directly (`next dev`, `next start`):
                                 # the web app has no /ws route or rewrite, so a same-origin
                                 # default would 404 and the client would sit in `connecting`
                                 # with an empty workspace.
                                 # Unset only when `serve` fronts the built web app, because then
                                 # /ws is same-origin and the session cookie rides the upgrade.

# ── Realtime tuning (wired in Phase 3) ────────────────────────────────────
COALESCE_MS=100                  # optional, default 100 — delta coalescing window

# ── CORS (development only) ───────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000
                                 # dev-only allowlist (comma-separated).
                                 # MUST be unset in production — production is same-origin only.

# ── Voice I/O (optional) ──────────────────────────────────────────────────
GROQ_API_KEY=                    # optional — voice STT/TTS returns 503 when absent
GROQ_TTS_DEFAULT_MODEL_ID=canopylabs/orpheus-v1-english
GROQ_TTS_DEFAULT_VOICE=hannah
GROQ_STT_MODEL_ID=whisper-large-v3-turbo

# ── Telemetry ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=         # optional — analytics disabled when absent
