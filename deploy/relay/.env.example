# Operator-owned connection relay; never place user AI provider keys here.
RELAY_ACCOUNT_ORIGIN=https://accounts.example.com
RELAY_TUNNEL_ORIGIN=https://connect.example.com
RELAY_HOSTS_DOMAIN=hosts.example.net
RELAY_DATABASE_URL=postgres://chorus:REPLACE@127.0.0.1/chorus_relay
RELAY_AUTH_SECRET= # required: at least 32 random bytes, stored only on the relay
RELAY_GITHUB_CLIENT_ID=
RELAY_GITHUB_CLIENT_SECRET=
RELAY_GOOGLE_CLIENT_ID=
RELAY_GOOGLE_CLIENT_SECRET=
RELAY_TURNSTILE_SECRET=
RELAY_TURNSTILE_SITE_KEY=
RELAY_MAX_ONLINE_HOSTS=100
RELAY_MAX_HOSTS_PER_ACCOUNT=3
